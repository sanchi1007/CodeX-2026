# Server Configuration
PORT=3000
NODE_ENV=production

# Database (MongoDB Atlas connection string for production)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/safestep?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/safestep

# Cryptographic Secrets (Required - generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your_32_byte_hex_secret_here
PEPPER_KEY=your_32_byte_hex_pepper_key_here

# Reverse Proxy Trust (Required for Render, Railway, AWS, Cloudflare to accurately read client IPs for rate-limiting)
TRUST_PROXY=true

# Socket.IO & CORS Whitelist (Comma-separated list of allowed production domains)
# Note: Render and Railway domains are automatically detected, but you can explicitly specify custom domains here.
ALLOWED_ORIGINS=https://safestep.onrender.com,https://your-custom-domain.com

# Optional Third-Party Services
GEOAPIFY_API_KEY=optional_geoapify_key
